<style>
  
    /* Estilo para el carrusel */
    .carousel {
        position: relative;
        width: 100%;
        height: 400px;
        overflow: hidden;
         /* rounded-lg */
    }

    .carousel img {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 1s ease;
    }

    .carousel img.inactive {
        opacity: 0;
    }

    .carousel img.active {
        opacity: 1;
    }

    
</style>
<style>
  /* Animación de rotación y escala para el ícono */
  .rotate-scale {
    animation: rotateScale 2s infinite ease-in-out;
  }
  @keyframes rotateScale {
    0% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.2) rotate(180deg); }
    100% { transform: scale(1) rotate(360deg); }
  }

  /* Parpadeo del texto */
  .fade {
    animation: fade 1.5s infinite ease-in-out;
  }
  @keyframes fade {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Barra de progreso */
  .progress {
    animation: progress 3s ease-in-out forwards;
  }
  @keyframes progress {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  /* Transición para ocultar la pantalla de carga */
  .fade-out {
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }
</style>

