<script>
    // Carrusel de imágenes
    const images = document.querySelectorAll('.carousel img');
    const buttons = document.querySelectorAll('.carousel button');

    let currentIndex = 0;

    function showImage(index) {
        images[currentIndex].classList.remove('active');
        images[currentIndex].classList.add('inactive');
        buttons[currentIndex].classList.remove('bg-blue-500');
        buttons[currentIndex].classList.add('bg-gray-300');

        currentIndex = index;

        images[currentIndex].classList.remove('inactive');
        images[currentIndex].classList.add('active');
        buttons[currentIndex].classList.remove('bg-gray-300');
        buttons[currentIndex].classList.add('bg-blue-500');
    }

    buttons.forEach((button, index) => {
        button.addEventListener('click', () => showImage(index));
    });

    // Cambiar imagen automáticamente cada 5 segundos
    setInterval(() => {
        const nextIndex = (currentIndex + 1) % images.length;
        showImage(nextIndex);
    }, 5000);

   


</script>

</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Oculta la pantalla de carga después de 3 segundos
    setTimeout(function () {
      const loadingScreen = document.getElementById("loading-screen");
      loadingScreen.classList.add("fade-out");
      loadingScreen.addEventListener("transitionend", function () {
        loadingScreen.style.display = "none";
      });
    }, 3000);
  });
</script>

