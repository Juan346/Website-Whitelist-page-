<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Página no encontrada</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Animaciones básicas de entrada */
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="min-h-screen bg-gray-900 flex flex-col items-center justify-center relative overflow-hidden">

  <!-- Imagen de fondo con superposición oscura -->
  <div class="absolute inset-0 z-0 animate-fadeIn" style="animation: fadeIn 1.5s;">
    <img src="https://media.discordapp.net/attachments/1015628636285575268/1298016158384918599/image.png?ex=6718b000&is=67175e80&hm=39cefdb2fa2158995e3ec9b0d5aa427eee6fdbf9ba0a7f8cc27353e0b3649175&=&format=webp&quality=lossless&width=1193&height=671" 
      alt="SA:MP Background" 
      class="w-full h-full object-cover blur-sm brightness-50">
    <div class="absolute inset-0 bg-black bg-opacity-40"></div>
  </div>

  <!-- Contenido principal centrado -->
  <div class="z-10 text-center text-white">
    <!-- Título 404 -->
    <h1 class="text-4xl md:text-6xl font-bold mb-4 animate-slideDown" style="animation: slideDown 0.5s;">
      404
    </h1>

    <!-- Subtítulo -->
    <h2 class="text-2xl md:text-3xl font-semibold mb-6 animate-slideDown" style="animation: slideDown 0.5s 0.5s;">
      Página no encontrada
    </h2>

    <!-- Descripción -->
    <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-md mx-auto animate-fadeIn" style="animation: fadeIn 0.5s 0.7s;">
      Parece que te has perdido en Los Santos. ¡No te preocupes, te ayudaremos a volver al juego!
    </p>

    <!-- Botón de regreso -->
    <div class="animate-slideUp" style="animation: slideUp 0.5s 0.9s;">
      <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-full transition duration-300 ease-in-out transform hover:scale-105">
        Volver al inicio
      </a>
    </div>
  </div>

</body>
</html>
